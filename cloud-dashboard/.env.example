# CurrentUsage Cloud Dashboard Environment Configuration
# Copy this file to .env or export these in your deployment / systemd / pm2 environment

# --- REQUIRED ---
# Secret key used for signing JWT authentication tokens (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_strong_random_jwt_secret

# --- APPLICATION & DOMAIN SETTINGS ---
# Port for Express HTTP & WebSocket server (Default: 3000)
PORT=3000

# Environment mode: 'production' or 'development' (Default: development)
# In production, auth cookies are flagged secure (HTTPS-only)
NODE_ENV=production

# Base public URL used for QR code generation and hardware labels (e.g. https://energy.yourdomain.com).
# If omitted, the server automatically infers the URL from incoming request Host / X-Forwarded-Proto headers.
APP_URL=https://dashboard.currentusage.com

# --- INITIAL ADMIN USER ---
# Initial password for the default admin account (admin@currentusage.com / admin)
# Used only on first startup if no admin account exists yet.
# If omitted, a random password is generated and logged to console on first run.
# ADMIN_INIT_PASSWORD=your_secure_admin_password

# --- MQTT BROKER SETTINGS ---
# Internal TCP connection to Mosquitto MQTT broker for telemetry ingestion and WebSocket bridging
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=admin_bridge_user
MQTT_PASS=replace_with_strong_random_bridge_password

# --- GOOGLE RECAPTCHA V2 SETTINGS ---
# Optional: Set both keys to enforce Google reCAPTCHA v2 ("I'm not a robot" checkbox) on login forms.
# If omitted or left empty, reCAPTCHA verification is bypassed in development.
# For local testing, you can use Google's official test keys:
# Site Key:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Secret Key: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- CUSTOM SMTP / MAILJET EMAIL SETTINGS ---
# Required for sending password reset emails to users and administrators.
# Mailjet SMTP Provider Settings:
# - Host: in-v3.mailjet.com (official Mailjet SMTP endpoint)
# - Port: 587 (TLS / STARTTLS), 465 (SSL, recommended if 587 is blocked by ISP), or 2525
# - Secure: false for 587/2525, true for 465
# - User: Your Mailjet API Key (e.g. 32-character hexadecimal key)
# - Pass: Your Mailjet Secret Key (e.g. 32-character secret key)
# - From: A sender email address validated/verified in your Mailjet account
# Note: If your ISP or hosting blocks port 587, set SMTP_PORT=465 and SMTP_SECURE=true
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailjet_api_key
SMTP_PASS=your_mailjet_secret_key
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME="CurrentUsage"

# Application / Brand name used in automated emails and UI notifications (Default: CurrentUsage)
APP_NAME=CurrentUsage
